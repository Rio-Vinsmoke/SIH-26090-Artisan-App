# =============================================================================
# SRISHTICONNECT BACKEND - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env or configure these variables in your deployment platform
# (e.g., Railway, Render, Heroku, AWS, GCP, Azure, Docker).
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL.
# =============================================================================

# Server Port (Cloud platforms usually assign PORT automatically, default: 8080)
PORT=8080
SERVER_PORT=8080

# Spring Profile (Options: local | prod | default)
SPRING_PROFILES_ACTIVE=prod

# =============================================================================
# Database Configuration (Managed Cloud MySQL or Local MySQL)
# =============================================================================
# Example Local: jdbc:mysql://localhost:3306/srishticonnect_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Example Cloud (Aiven/Clever Cloud/AWS RDS/Railway): jdbc:mysql://your-cloud-mysql-host:3306/srishticonnect_db?sslMode=REQUIRED
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/srishticonnect_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# =============================================================================
# JWT Authentication Secret & Expiration
# =============================================================================
# Generate a strong 256-bit secret key for production (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_for_security_2026
JWT_EXPIRATION=86400000

# =============================================================================
# Frontend URL & CORS Configuration
# =============================================================================
# Set to your deployed React application URL (without trailing slash)
# e.g., https://srishticonnect.vercel.app or https://srishticonnect.netlify.app
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Google OAuth 2.0 Credentials (From Google Cloud Console)
# =============================================================================
# Required for "Continue with Google" OAuth login
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================================================
# AI Services & Gemini API Key (Optional / Multilingual AI & Vision)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
AI_REMOVEBG_KEY=
